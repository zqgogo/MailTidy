{
  "name": "mailtidy",
  "version": "0.1.0",
  "private": true,
  "description": "Email agent that triages inboxes, drafts replies, finds subscriptions, and produces daily briefings.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "mailtidy": "./dist/interfaces/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/interfaces/cli.ts",
    "demo:cleanup": "tsx src/interfaces/cli.ts run-cleanup --demo",
    "demo:brief": "tsx src/interfaces/cli.ts daily-brief --demo",
    "demo:subscriptions": "tsx src/interfaces/cli.ts subscription-scan --demo",
    "demo:drafts": "tsx src/interfaces/cli.ts draft-replies --demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.74.1",
    "@earendil-works/pi-ai": "^0.74.1",
    "commander": "^12.1.0",
    "googleapis": "^173.0.0",
    "imapflow": "^1.3.5",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
